{
  "training_source": "vendor/training",
  "models": {
    "meno-lite-0.2": {
      "base_url": "http://localhost:8000/v1",
      "model": "meno-lite-0.2",
      "weights": "bond005/meno-lite-0.2; pin the exact weights revision before a scored run"
    },
    "meno-lite-0.1": null,
    "qwen3.5-9b": null
  },
  "embedding": {
    "backend": "openai",
    "base_url": "http://localhost:8001/v1",
    "model": "bge-m3",
    "source_model": "BAAI/bge-m3",
    "revision": null,
    "batch_size": 16,
    "query_prefix": "",
    "passage_prefix": ""
  },
  "judge": null,
  "protocol": {
    "seed": 42,
    "temperature": 0,
    "extraction_stage": "one_stage",
    "extraction_decoding": "structured",
    "structured_limits": {
      "entities": 16,
      "relations": 16,
      "name_chars": 80,
      "description_chars": 200
    },
    "prompt_variant": 1,
    "with_signatures": true,
    "chunk_chars": 3500,
    "chunk_overlap_chars": 200,
    "extraction_max_tokens": 4096,
    "answer_max_tokens": 256,
