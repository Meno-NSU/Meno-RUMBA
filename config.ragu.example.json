    },
    "meno-lite-0.1": null,
    "qwen2.5-7b-instruct": null
  },
  "embedding": {
    "backend": "openai",
    "base_url": "http://localhost:8001/v1",
    "model": "bge-m3",
    "source_model": "BAAI/bge-m3",
    "revision": null,
    "batch_size": 16,
    "query_prefix": "",
    "passage_prefix": "",
    "dimensions": 1024
  },
  "runtime": {
    "concurrency": 4,
    "timeout_s": 300,
    "max_retries": 2
  },
  "reranker": {
    "base_url": "http://localhost:8002/v1",
    "model": "bge-reranker-v2-m3",
    "source_model": "BAAI/bge-reranker-v2-m3",
    "revision": null
  },
  "judge": null,
  "protocol": {
    "seed": 42,
    "temperature": 0,
    "top_p": 1.0,
    "repetition_penalty": 1.03,
    "extraction_max_tokens": 4096,
    "answer_max_tokens": 256,
    "answer_stop": [
      "\n"
    ],
    "chunk_chars": 3500,
    "chunk_overlap_chars": 200,
    "entity_validation": true,
    "relation_validation": true,
    "icl": {
      "enabled": true,
      "num_examples": 1,
