      "rerank_top_k": 5,
      "use_summary": false,
      "use_chunks": true
    },
    "context_max_tokens": 12000,
    "history_policy": "all-provided-sessions-as-official-rag",
    "judge_max_tokens": 4096,
    "extraction_decoding": "bounded",
    "structured_limits": {
      "entities": 16,
      "relations": 16,
      "name_chars": 80,
      "description_chars": 200
    },
    "grammar_whitespace_chars": 8,
    "server_structured_outputs": {
      "backend": "xgrammar",
      "disable_any_whitespace": true
    }
  }
